android_app {
    name: "microg-permissions-helper",

    srcs: ["src/**/*.java"],

    certificate: "platform",
    privileged: true,
    product_specific: true,

    // Product partition: PRODUCT_ENFORCE_PRODUCT_PARTITION_INTERFACE requires an
    // explicit stable SDK. Everything this app calls is public or @SystemApi.
    sdk_version: "system_current",
}
